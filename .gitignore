# squid 的 .gitignore
#
# 原则:仓库里只放源码、文档、脚本和配方。凡是构建出来的、机器本地产生的、
# 或者只用来参考的东西,都不进版本历史——一旦提交进去,3.3 GB 的构建产物就
# 永远赖在历史里了。

# ── 构建产物 ─────────────────────────────────────────────────────────
# cargo 的输出(debug / release / 各 target triple 都在它下面)。
/target/
/src-tauri/target/
/artifacts/
/release/
# scripts/release.sh 的产物:通用二进制 + tar.gz + sha256。
# 桌面发布包只存在于 origin 的 releases 分支,GitHub 只镜像源码。
/dist/
node_modules/
.vite/
src-tauri/gen/
*.tar.gz
*.sha256
*.dmg
*.zip
*.exe

# ── 只读参考代码 ─────────────────────────────────────────────────────
# 本地 clone 的第三方参考项目(自带 .git,数百 MB),不打包、不提交、不发版。
/Mole/

# ── Rust / 覆盖率 ────────────────────────────────────────────────────
**/*.rs.bk
*.profraw
*.profdata
/coverage/
tarpaulin-report.html
default.prof*

# ── Python(测试脚手架 scripts/tui_smoke.py)─────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/

# ── 编辑器 / IDE ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── macOS / 系统垃圾 ─────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── 本机专属配置 ─────────────────────────────────────────────────────
# squid 的数据在 ~/Library/Application Support/squid,不落在这棵树里;
# 下面这几条只是防止有人把本地实验配置或 .env 顺手 add 进来。
.env
.env.*
!.env.example
*.local

# 输入法/软件在 cwd 落的调试日志（sogou 等）
debug.log
