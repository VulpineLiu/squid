{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squid",
  "version": "0.1.11",
  "identifier": "app.nex.squid",
  "mainBinaryName": "squid-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Squid",
        "url": "index.html",
        "width": 1220,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "Clean, uninstall, purge and monitor your Mac or PC.",
    "longDescription": "Squid is a cross-platform system care app for macOS and Windows. It scans caches and system junk, removes applications with their leftovers, finds project build artefacts, maps disk usage and monitors live system health.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi"
      }
    }
  }
}
